# Copy this file to `.env` and fill in real values. Never commit `.env`.

# OpenAI (used for receipt/voice/statement parsing — added from stage 3 onward)
OPENAI_API_KEY=

# Telegram bot (BotFather token — used from stage 2 onward)
TELEGRAM_BOT_TOKEN=

# Restricts the bot to only respond to you, and is required for all proactive/scheduled
# messages (daily budget+safe-to-spend check, weekly insights) — those jobs silently skip
# if this isn't set, since there's no chat to send to otherwise.
# Leave blank on first run; the bot logs your numeric Telegram user id on first message.
TELEGRAM_ALLOWED_USER_ID=

# Supabase (used from stage 4 onward)
SUPABASE_URL=
SUPABASE_KEY=
# service_role secret key — Project Settings > API Keys. Bypasses RLS; used by the
# trusted backend (bot + weekly job) since this app has no Supabase Auth layer.
SUPABASE_SERVICE_ROLE_KEY=
